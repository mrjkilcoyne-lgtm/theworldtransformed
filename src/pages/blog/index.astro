---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing" description="Articles on economics, technology policy, philosophy, and coordination mechanisms">
  <article>
    <h1>Writing</h1>
    <p class="intro">Articles on economics, technology policy, philosophy, and coordination mechanisms.</p>

    {posts.length === 0 ? (
      <p class="empty">Nothing published yet. Check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`}>
              <h2>{post.data.title}</h2>
              <p class="description">{post.data.description}</p>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-GB', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              {post.data.tags.length > 0 && (
                <div class="tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </article>
</BaseLayout>

<style>
  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: #58a6ff;
  }

  .intro {
    color: #8b949e;
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  .empty {
    color: #8b949e;
    font-style: italic;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    border-bottom: 1px solid #30363d;
  }

  .post-list li:last-child {
    border-bottom: none;
  }

  .post-list a {
    display: block;
    padding: 1.5rem 0;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .post-list a:hover {
    opacity: 0.8;
  }

  .post-list h2 {
    font-size: 1.5rem;
    color: #c9d1d9;
    margin-bottom: 0.5rem;
  }

  .post-list a:hover h2 {
    color: #58a6ff;
  }

  .description {
    color: #8b949e;
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  time {
    font-size: 0.875rem;
    color: #8b949e;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    background: #161b22;
    border: 1px solid #30363d;
    color: #8b949e;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2rem;
    }
  }
</style>
